# Postgres connection string (Neon / Render Postgres / local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velozity?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS — comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cron
OVERDUE_SWEEP_CRON="*/5 * * * *"
